{
  "name": "prompt-crash-lab",
  "version": "1.3.0",
  "private": true,
  "description": "Prompt Crash Lab: generate adversarial test cases for an LLM prompt, execute them, detect failures, optimise the prompt and compare results.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@react-three/fiber": "^9.8.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
