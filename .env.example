# Prompt Crash Lab: environment configuration
# Copy this file to `.env` and fill in the providers you want to use.
# Never commit `.env`. Keys stay on the server and are never sent to the browser.

# Server port for the API (the Vite dev server proxies /api to it)
PORT=8787

# --- Anthropic (Claude) ------------------------------------------------------
# Get a key from https://platform.claude.com/ . Leave blank to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Claude Opus 5.5 defaults to medium)
ANTHROPIC_EFFORT=medium

# --- Google Gemini -----------------------------------------------------------
# Get a key from Google AI Studio. You can also paste it in Settings & Providers
# in the app (held in server memory for the session only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# true = test cases, judging and improved prompts are always generated with the
# Gemini key (never the built-in rule-based generator). Also settable in the UI.
GEMINI_ONLY_GENERATION=false
# Optional: override the API base URL
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Any OpenAI-compatible Chat Completions endpoint -------------------------
# Works with OpenAI, Azure OpenAI (v1 endpoint), OpenRouter, Groq, Together,
# LM Studio or Ollama (http://localhost:11434/v1, key can be any string).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Default providers for each role: anthropic | gemini | openai-compatible | demo
# "executor" runs the prompt under test; "analyst" generates tests, judges and optimises.
DEFAULT_EXECUTOR=demo
DEFAULT_ANALYST=demo

# Where experiments are stored (JSON file)
DATA_FILE=data/experiments.json
